# SynapseReason Runtime Configuration
# Set SAMPLE_MODE=true for zero-key instant local demo mode (Judge-ready out of the box)
SAMPLE_MODE=true

# NVIDIA NIM & NeMo Guardrails
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Zetaris Networked Data Fabric
ZETARIS_ENDPOINT=https://fabric.zetaris.cloud/api/v1
ZETARIS_API_KEY=zetaris_live_key_here

# Meterless Serverless Token & Cost Governance
METERLESS_ENDPOINT=https://api.meterless.io/v1/telemetry
METERLESS_API_KEY=meterless_live_key_here
METERLESS_BUDGET_CAP_USD=0.50

# Bright Data Web Scraping & SERP Bounty
BRIGHTDATA_API_KEY=brightdata_api_key_here
